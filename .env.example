# KB Lockup Configuration
# Copy this file to .env and fill in your values

# DART OpenAPI Key (required)
# Get your key from: https://opendart.fss.or.kr/
DART_API_KEY=your_dart_api_key_here

# Qwen API Key (required for AI extraction)
# Get your key from: https://dashscope.aliyuncs.com/
QWEN_API_KEY=your_qwen_api_key_here

# Telegram Bot Token (required for bot)
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Database path (default: data/kb_lockup.db)
# DB_PATH=data/kb_lockup.db

# Optional: Export directory (default: exports)
# EXPORT_DIR=exports

# Optional: Qwen model (default: qwen-plus)
# QWEN_MODEL=qwen-plus

# Optional: Minimum extraction confidence score (default: 0.6)
# MIN_EXTRACTION_SCORE=0.6

# Optional: Reminder check hour in KST (default: 8)
# REMINDER_CHECK_HOUR=8

# Optional: Log level (default: INFO)
# LOG_LEVEL=INFO
